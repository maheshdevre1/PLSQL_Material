CREATE OR REPLACE PROCEDURE second_highest_salary
IS
    v_salary NUMBER;
BEGIN
    SELECT MAX(salary)
    INTO v_salary
    FROM employee
    WHERE salary < (SELECT MAX(salary) FROM employee);

    DBMS_OUTPUT.PUT_LINE('Second Highest Salary: ' || v_salary);
END;
/

