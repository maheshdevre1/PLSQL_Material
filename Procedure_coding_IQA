CREATE OR REPLACE PROCEDURE delete_duplicates
IS
BEGIN
    DELETE FROM employee
    WHERE ROWID NOT IN (
        SELECT MIN(ROWID)
        FROM employee
        GROUP BY emp_id
    );

    COMMIT;
END;
