12. Procedure to Split Comma-Separated Values and Insert
----------------------------------------------------------
CREATE OR REPLACE PROCEDURE split_insert (
    p_data VARCHAR2
)
IS
    v_val VARCHAR2(100);
BEGIN
    FOR i IN 1..REGEXP_COUNT(p_data, ',') + 1 LOOP
        v_val := REGEXP_SUBSTR(p_data, '[^,]+', 1, i);

        INSERT INTO temp_table VALUES (v_val);
    END LOOP;

    COMMIT;
END;
/

