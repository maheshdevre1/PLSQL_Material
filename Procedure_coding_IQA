6. Procedure Using Nested Cursor
----------------------------------
CREATE OR REPLACE PROCEDURE dept_emp_count
IS
    CURSOR dept_cur IS SELECT department_id FROM department;
    CURSOR emp_cur(p_dept NUMBER) IS
        SELECT COUNT(*) cnt FROM employee WHERE department_id = p_dept;

    v_count NUMBER;
BEGIN
    FOR d IN dept_cur LOOP
        OPEN emp_cur(d.department_id);
        FETCH emp_cur INTO v_count;
        CLOSE emp_cur;

        DBMS_OUTPUT.PUT_LINE('Dept: ' || d.department_id || ' Count: ' || v_count);
    END LOOP;
END;
/

