12. Procedure to Check Prime Number
-------------------------------------------
CREATE OR REPLACE PROCEDURE check_prime (
    n NUMBER
)
IS
    is_prime BOOLEAN := TRUE;
BEGIN
    IF n <= 1 THEN
        is_prime := FALSE;
    END IF;

    FOR i IN 2..SQRT(n) LOOP
        IF MOD(n, i) = 0 THEN
            is_prime := FALSE;
            EXIT;
        END IF;
    END LOOP;

    IF is_prime THEN
        DBMS_OUTPUT.PUT_LINE('Prime');
    ELSE
        DBMS_OUTPUT.PUT_LINE('Not Prime');
    END IF;
END;
/


