CREATE OR REPLACE PROCEDURE dynamic_update (
    p_table VARCHAR2,
    p_column VARCHAR2,
    p_value VARCHAR2,
    p_id NUMBER
)
IS
    v_sql VARCHAR2(500);
BEGIN
    v_sql := 'UPDATE ' || p_table ||
             ' SET ' || p_column || ' = :1 WHERE emp_id = :2';

    EXECUTE IMMEDIATE v_sql USING p_value, p_id;

    COMMIT;
END;
/

