1. Employee Salary Increment Procedure
👉 Write a procedure to increase salary of employees based on department
------------------------------------------------------------------------
CREATE OR REPLACE PROCEDURE update_salary (
    p_dept_id NUMBER,
    p_percent NUMBER
)
IS
BEGIN
    UPDATE employee
    SET salary = salary + (salary * p_percent / 100)
    WHERE department_id = p_dept_id;

    COMMIT;
END;
/

