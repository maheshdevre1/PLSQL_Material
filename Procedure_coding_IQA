1. Bulk Salary Update using BULK COLLECT & FORALL
-----------------------------------------------------

👉 Optimize performance (very common interview twist)

CREATE OR REPLACE PROCEDURE bulk_salary_update (
    p_dept_id NUMBER,
    p_percent NUMBER
)
IS
    TYPE emp_tab IS TABLE OF employee%ROWTYPE;
    v_emp emp_tab;
BEGIN
    SELECT * BULK COLLECT INTO v_emp
    FROM employee
    WHERE department_id = p_dept_id;

    FORALL i IN v_emp.FIRST..v_emp.LAST
        UPDATE employee
        SET salary = v_emp(i).salary + (v_emp(i).salary * p_percent / 100)
        WHERE emp_id = v_emp(i).emp_id;

    COMMIT;
END;
/

2. Procedure with Savepoint & Rollback
--------------------------------------------

👉 Transaction control question

CREATE OR REPLACE PROCEDURE transfer_safe (
    p_from NUMBER,
    p_to NUMBER,
    p_amt NUMBER
)
IS
BEGIN
    SAVEPOINT before_transfer;

    UPDATE account SET balance = balance - p_amt WHERE acc_no = p_from;

    UPDATE account SET balance = balance + p_amt WHERE acc_no = p_to;

    COMMIT;

EXCEPTION
    WHEN OTHERS THEN
        ROLLBACK TO before_transfer;
END;
/

3. Raise Custom Exception
--------------------------

CREATE OR REPLACE PROCEDURE withdraw_amount (
    p_acc NUMBER,
    p_amt NUMBER
)
IS
    v_balance NUMBER;
    insufficient_balance EXCEPTION;
BEGIN
    SELECT balance INTO v_balance FROM account WHERE acc_no = p_acc;

    IF v_balance < p_amt THEN
        RAISE insufficient_balance;
    END IF;

    UPDATE account SET balance = balance - p_amt WHERE acc_no = p_acc;

    COMMIT;

EXCEPTION
    WHEN insufficient_balance THEN
        DBMS_OUTPUT.PUT_LINE('Insufficient Balance');
END;
/

4. Dynamic Column Update (Dynamic SQL)
