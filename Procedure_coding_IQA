7. Procedure to Transfer Amount Between Accounts
-------------------------------------------------
CREATE OR REPLACE PROCEDURE transfer_amount (
    p_from_acc NUMBER,
    p_to_acc NUMBER,
    p_amount NUMBER
)
IS
BEGIN
    UPDATE account
    SET balance = balance - p_amount
    WHERE acc_no = p_from_acc;

    UPDATE account
    SET balance = balance + p_amount
    WHERE acc_no = p_to_acc;

    COMMIT;
END;
/

8. Procedure Using Loop (Factorial)
---------------------------------------
CREATE OR REPLACE PROCEDURE factorial_proc (
    n NUMBER
)
IS
    result NUMBER := 1;
BEGIN
    FOR i IN 1..n LOOP
        result := result * i;
    END LOOP;

    DBMS_OUTPUT.PUT_LINE('Factorial: ' || result);
END;
/

