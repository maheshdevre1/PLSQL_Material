END;
/

10. Function with Default Parameter
---------------------------------------
CREATE OR REPLACE FUNCTION calculate_tax (
    p_salary NUMBER,
    p_tax_rate NUMBER DEFAULT 10
)
RETURN NUMBER
IS
BEGIN
    RETURN p_salary * p_tax_rate / 100;
END;
/


11. Function Returning SYS_REFCURSOR
--------------------------------------
CREATE OR REPLACE FUNCTION get_employees_by_dept (
    p_dept_id NUMBER
)
RETURN SYS_REFCURSOR
IS
    v_cursor SYS_REFCURSOR;
BEGIN
    OPEN v_cursor FOR
    SELECT * FROM employee WHERE department_id = p_dept_id;

    RETURN v_cursor;
END;
/


12. Function Using Dynamic SQL
---------------------------------
CREATE OR REPLACE FUNCTION get_table_count (
    p_table_name VARCHAR2
)
RETURN NUMBER
IS
    v_count NUMBER;
    v_sql VARCHAR2(200);
BEGIN
    v_sql := 'SELECT COUNT(*) FROM ' || p_table_name;

    EXECUTE IMMEDIATE v_sql INTO v_count;

    RETURN v_count;
END;
/

13. Function to Handle NULL Values
----------------------------------
CREATE OR REPLACE FUNCTION safe_salary (
    p_salary NUMBER
)
RETURN NUMBER
IS
BEGIN
    RETURN NVL(p_salary, 10000);
END;
/


14. Function to Check Even or Odd
---------------------------------
CREATE OR REPLACE FUNCTION check_even_odd (
    n NUMBER
)
RETURN VARCHAR2
IS
BEGIN
    IF MOD(n, 2) = 0 THEN
        RETURN 'EVEN';
    ELSE
        RETURN 'ODD';
    END IF;
END;
/


15. Function Calling Another Function
---------------------------------------
CREATE OR REPLACE FUNCTION total_with_bonus (
    p_salary NUMBER
)
RETURN NUMBER
IS
BEGIN
    RETURN p_salary + calculate_bonus(p_salary);
END;
/
