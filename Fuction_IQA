1. Function to Get Employee Salary
-----------------------------------
CREATE OR REPLACE FUNCTION get_salary (
    p_emp_id NUMBER
)
RETURN NUMBER
IS
    v_salary NUMBER;
BEGIN
    SELECT salary INTO v_salary
    FROM employee
    WHERE emp_id = p_emp_id;

    RETURN v_salary;
END;
/

2. Function to Calculate Annual Salary
------------------------------------------
CREATE OR REPLACE FUNCTION annual_salary (
    p_salary NUMBER
)
RETURN NUMBER
IS
BEGIN
    RETURN p_salary * 12;
END;
/


3. Function to Check Prime Number
----------------------------------
CREATE OR REPLACE FUNCTION is_prime (
    n NUMBER
)
RETURN VARCHAR2
IS
BEGIN
    IF n <= 1 THEN
        RETURN 'NOT PRIME';
    END IF;

    FOR i IN 2..SQRT(n) LOOP
        IF MOD(n, i) = 0 THEN
            RETURN 'NOT PRIME';
        END IF;
    END LOOP;

    RETURN 'PRIME';
END;
/

4. Function to Get Department Employee Count
---------------------------------------------
CREATE OR REPLACE FUNCTION dept_emp_count (
    p_dept_id NUMBER
)
RETURN NUMBER
IS
    v_count NUMBER;
BEGIN
    SELECT COUNT(*) INTO v_count
    FROM employee
    WHERE department_id = p_dept_id;

    RETURN v_count;
END;
/

5. Function with Exception Handling
-------------------------------------
CREATE OR REPLACE FUNCTION get_employee_name (
    p_emp_id NUMBER
)
RETURN VARCHAR2
IS
    v_name VARCHAR2(50);
BEGIN
    SELECT name INTO v_name
    FROM employee
    WHERE emp_id = p_emp_id;

    RETURN v_name;

EXCEPTION
    WHEN NO_DATA_FOUND THEN
        RETURN 'NOT FOUND';
END;
/

6. Function to Calculate Bonus Based on Salary
-------------------------------------------------
CREATE OR REPLACE FUNCTION calculate_bonus (
    p_salary NUMBER
)
RETURN NUMBER
IS
BEGIN
    IF p_salary > 50000 THEN
        RETURN p_salary * 0.20;
    ELSIF p_salary > 30000 THEN
        RETURN p_salary * 0.10;
    ELSE
        RETURN p_salary * 0.05;
    END IF;
END;
/

7. Function Using Cursor
---------------------------
CREATE OR REPLACE FUNCTION total_salary
RETURN NUMBER
IS
    CURSOR c IS SELECT salary FROM employee;
    v_total NUMBER := 0;
BEGIN
    FOR rec IN c LOOP
        v_total := v_total + rec.salary;
    END LOOP;

    RETURN v_total;
END;
/

